{
	"name": "phrasevault",
	"version": "0.1.0",
	"description": "Obsidian plugin that turns screenshots of English text into numbered, AI-annotated phrase notes.",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build:dev": "node esbuild.config.mjs dev-once",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"install-dev": "node scripts/install-dev.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"lint": "eslint .",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"english",
		"language-learning"
	],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.20.5",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.6.0",
		"globals": "^17.14.0",
		"jiti": "^2.7.0",
		"obsidian": "^1.14.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.73.0",
		"vitest": "^5.1.0",
		"yaml": "^2.9.1"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^1.9.0",
		"zod": "^4.6.7"
	}
}
